def main():
    """
    主程序入口
    执行完整的数据分析流程
    """
    # ---- 打印标题 ----
    print("=" * 60)  # 打印60个等号作为分隔线
    print("SME关联方现金流集中度检测系统 v1.0")
    print("=" * 60)

    # ---- 1. 初始化配置 ----
    config = Config()
    print(f"\n📋 配置:")
    print(f"   - 回溯窗口: {config.LOOKBACK_DAYS} 天")
    print(f"   - 关联方占比阈值: {config.RELATED_PARTY_RATIO_THRESHOLD * 100}%")

    # ---- 2. 删除旧数据重新生成（确保数据一致性） ----
    # shutil 是高级文件操作库
    import shutil
    if config.DATA_PATH.exists():
        # rmtree = remove tree，递归删除整个目录
        shutil.rmtree(config.DATA_PATH)
    # 重新创建空目录
    config.DATA_PATH.mkdir(exist_ok=True)

    # ---- 3. 加载或生成数据 ----
    loans, customers, transactions, relations = load_or_generate_data(config)

    # ---- 4. 现金流分析 ----
    print("\n🔍 分析现金流...")
    analyzer = CashFlowAnalyzer(config)

    total_inflow = analyzer.calculate_total_operating_inflow(loans, customers, transactions)
    print(f"   - 有效经营客户: {len(total_inflow)} 个")

    related_inflow = analyzer.calculate_related_party_inflow(relations)
    print(f"   - 有关联方交易的客户: {len(related_inflow)} 个")

    risk_metrics = analyzer.calculate_risk_metrics(total_inflow, related_inflow)
    print(f"   - 有效分析样本: {len(risk_metrics)} 个")

    # ---- 5. 风险检测 ----
    print("\n🚨 风险检测...")
    detector = RiskDetector(config)
    risk_results = detector.detect(risk_metrics)

    flagged = risk_results[risk_results['risk_flag'] != 'Normal']
    print(f"   - 发现风险客户: {len(flagged)} 个")

    # 如果有风险客户，打印详细分布
    if len(flagged) > 0:
        print("\n📊 风险分布:")
        # value_counts() 统计各等级数量，.to_string() 转为字符串显示
        print(risk_results['risk_flag'].value_counts().to_string())

        # 打印高风险客户示例
        high = risk_results[risk_results['risk_flag'] == 'High'].head(5)
        if len(high) > 0:
            print("\n📋 高风险客户示例:")
            # iterrows() 遍历行
            for _, row in high.iterrows():
                print(f"   - {row['party_name']}: 关联方占比 {row['related_party_inflow_ratio']:.1%}")

    # ---- 6. 导出CSV报告 ----
    print("\n📄 生成报告...")
    # encoding='utf-8-sig' 让Excel能正确显示中文（带BOM的UTF-8）
    risk_results.to_csv(
        config.OUTPUT_PATH / "risk_report.csv",
        index=False,
        encoding='utf-8-sig'
    )
    print(f"   ✅ 报告已保存")

    # ---- 7. 生成可视化 ----
    print("\n📈 生成可视化...")
    viz = Visualizer(config)
    viz.plot_all(risk_results)

    # ---- 8. 输出最终摘要 ----
    print("\n" + "=" * 60)
    print("✅ 分析完成!")
    print(f"   - 总样本: {len(risk_results)} 个客户")
    print(f"   - 风险客户: {len(flagged)} 个")
    print(f"   - 高风险: {len(risk_results[risk_results['risk_flag'] == 'High'])} 个")
    print(f"   - 中风险: {len(risk_results[risk_results['risk_flag'] == 'Medium'])} 个")
    print(f"   - 低风险: {len(risk_results[risk_results['risk_flag'] == 'Low'])} 个")
    print("=" * 60)


