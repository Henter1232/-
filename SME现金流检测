class Visualizer:
    """
    可视化工具
    生成3种图表：风险分布图、Top风险客户图、占比分布图
    """

    def __init__(self, config):
        """构造函数，接收配置对象"""
        self.config = config

        # 图表输出目录
        self.output_dir = config.OUTPUT_PATH / "charts"
        self.output_dir.mkdir(exist_ok=True)

        # ---- 设置中文字体 ----
        # 默认字体不支持中文，需要手动设置
        try:
            # 按优先级尝试多个中文字体
            plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']
            # 解决负号显示为方块的问题
            plt.rcParams['axes.unicode_minus'] = False
        except:
            pass  # 如果字体设置失败，使用默认字体（中文会显示为方块）

    def plot_all(self, df):
        """
        生成所有图表
        """
        if len(df) == 0:
            return

        self.plot_risk_distribution(df)   # 图表1：风险等级分布
        self.plot_top_risky_customers(df) # 图表2：Top风险客户
        self.plot_ratio_distribution(df)  # 图表3：占比分布

        print(f"   📊 图表已保存至: {self.output_dir}")

    def plot_risk_distribution(self, df):
        """
        风险等级分布图（柱状图 + 饼图）
        用于快速了解整体风险状况
        """
        # ---- 创建子图 ----
        # 1行2列，总大小12x5英寸
        # fig 是画布对象，axes 是子图对象数组（2个）
        fig, axes = plt.subplots(1, 2, figsize=(12, 5))

        # ---- 统计各风险等级的数量 ----
        # value_counts() 返回 Series，索引是等级，值是数量
        risk_counts = df['risk_flag'].value_counts()

        # ---- 定义颜色 ----
        # 红色=高风险，橙色=中风险，黄色=低风险，绿色=正常
        colors = {
            'High': '#e74c3c',    # 红色
            'Medium': '#f39c12',  # 橙色
            'Low': '#f1c40f',     # 黄色
            'Normal': '#2ecc71'   # 绿色
        }
        # 根据风险等级获取对应的颜色列表
        bar_colors = [colors.get(x, '#95a5a6') for x in risk_counts.index]

        # ---- 左图：柱状图 ----
        axes[0].bar(risk_counts.index, risk_counts.values, color=bar_colors)
        axes[0].set_title('风险等级分布', fontsize=14)  # 标题
        axes[0].set_xlabel('风险等级')                  # X轴标签
        axes[0].set_ylabel('客户数量')                  # Y轴标签

        # 在柱子上方添加数值标签
        # enumerate() 同时获取索引i和值v
        for i, v in enumerate(risk_counts.values):
            axes[0].text(i, v + 0.5, str(v), ha='center', va='bottom')

        # ---- 右图：饼图 ----
        # 只显示数量>0的等级
        non_zero = risk_counts[risk_counts > 0]
        if len(non_zero) > 0:
            # explode 将某些扇区分离突出显示（高风险和中风险）
            explode = [0.05 if x in ['High', 'Medium'] else 0 for x in non_zero.index]
            axes[1].pie(
                non_zero.values,                    # 数值
                labels=non_zero.index,              # 标签
                autopct='%1.1f%%',                  # 显示百分比，保留1位小数
                colors=[colors.get(x, '#95a5a6') for x in non_zero.index],
                explode=explode                     # 分离扇区
            )
        axes[1].set_title('风险等级占比', fontsize=14)

        # ---- 保存 ----
        plt.tight_layout()  # 自动调整布局，避免重叠
        plt.savefig(self.output_dir / 'risk_distribution.png', dpi=150)
        plt.close()  # 关闭图形，释放内存

    def plot_top_risky_customers(self, df, top_n=10):
        """
        Top N 高风险客户（横向柱状图）
        用于贷后团队重点排查
        """
        # 筛选高风险和中风险客户，取前top_n个
        high_risk = df[df['risk_flag'].isin(['High', 'Medium'])].head(top_n)
        if len(high_risk) == 0:
            return

        # ---- 创建图形 ----
        fig, ax = plt.subplots(figsize=(12, 6))

        # ---- 处理客户名称（过长则截断） ----
        # 列表推导式：如果名称长度>12，截断并加...
        short_names = [
            str(n)[:12] + '...' if len(str(n)) > 12 else str(n)
            for n in high_risk['party_name']
        ]

        # ---- 绘制横向柱状图 ----
        # barh() = horizontal bar chart
        bars = ax.barh(
            short_names,                                    # Y轴：客户名称
            high_risk['related_party_inflow_ratio'],        # X轴：关联方占比
            color=['#e74c3c' if x == 'High' else '#f39c12' for x in high_risk['risk_flag']]
        )
        ax.set_xlabel('关联方现金流占比')
        ax.set_title(f'Top {top_n} 风险客户', fontsize=14)
        ax.invert_yaxis()  # 反转Y轴，让占比最高的在顶部

        # ---- 在柱子上添加百分比标签 ----
        for bar in bars:
            width = bar.get_width()
            ax.text(width + 0.01, bar.get_y() + bar.get_height()/2,
                   f'{width:.1%}', va='center')

        # ---- 添加阈值参考线 ----
        ax.axvline(x=0.5, color='orange', linestyle='--', alpha=0.7, label='50%阈值')
        ax.axvline(x=0.8, color='red', linestyle='--', alpha=0.7, label='80%阈值')
        ax.legend()

        # ---- 保存 ----
        plt.tight_layout()
        plt.savefig(self.output_dir / 'top_risky_customers.png', dpi=150)
        plt.close()

    def plot_ratio_distribution(self, df):
        """
        关联方占比分布直方图
        用于判断阈值设置是否合理
        """
        # 只分析有风险的客户（排除Normal）
        risky = df[df['risk_flag'].isin(['High', 'Medium', 'Low'])]
        if len(risky) == 0:
            return

        # ---- 创建图形 ----
        fig, ax = plt.subplots(figsize=(10, 5))

        # ---- 绘制直方图 ----
        # bins=20 将数据分成20个区间
        ax.hist(
            risky['related_party_inflow_ratio'],
            bins=20,
            alpha=0.7,          # 透明度0.7
            color='steelblue',
            edgecolor='black'   # 边框颜色
        )

        # ---- 添加阈值参考线 ----
        ax.axvline(x=0.5, color='orange', linestyle='--', linewidth=2, label='50%阈值')
        ax.axvline(x=0.8, color='red', linestyle='--', linewidth=2, label='80%阈值')

        ax.set_xlabel('关联方现金流占比')
        ax.set_ylabel('客户数量')
        ax.set_title('风险客户关联方占比分布', fontsize=14)
        ax.legend()

        # ---- 保存 ----
        plt.tight_layout()
        plt.savefig(self.output_dir / 'ratio_distribution.png', dpi=150)
        plt.close()


